<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simulateur Prévisionnel - Professionnel Libéral</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="container">
        <header>
            <div class="logo-container">
                <img id="logo-img" src="logo_entier_noir.png" alt="Logo" class="logo">
            </div>
            <h1>PRÉVI'PRO</h1>
            <p class="subtitle">Simulation de votre chiffre d'affaires, charges et bénéfice annuel</p>
            <div class="header-actions">
                <button type="button" class="btn-export" id="btn-save-simulation">💾 Sauvegarder</button>
                <button type="button" class="btn-export" id="btn-load-simulations">📂 Mes simulations</button>
            </div>
        </header>

        <div class="form-container">
            <!-- SECTION 1: INFORMATIONS DE BASE -->
            <section class="form-section section-saisie">
                <h2>1. Informations de base</h2>
                <div class="content-card">
                    <div class="form-group">
                        <label for="prix-seance">
                            Prix moyen d'une séance (€)
                            <span class="tooltip-icon" title="Prix moyen que vous facturez pour une séance. Si vos tarifs varient, faites une moyenne.">ℹ️</span>
                        </label>
                        <input type="number" id="prix-seance" min="0" step="0.01" placeholder="Ex: 50">
                    </div>
                    <div class="form-group">
                        <label for="taux-remplissage">
                            Taux de remplissage (%)
                            <span class="tooltip-icon" title="Pourcentage de séances réellement effectuées par rapport au nombre de créneaux disponibles. Ex: 80% signifie que 8 séances sur 10 possibles sont réalisées.">ℹ️</span>
                        </label>
                        <input type="number" id="taux-remplissage" min="0" max="100" step="1" placeholder="Ex: 80">
                        <small>Pourcentage de séances réellement effectuées</small>
                    </div>
                    <div class="form-group">
                        <label>Redevance éventuelle
                            <span class="tooltip-icon" title="Si vous êtes en contrat de collaboration, vous pouvez avoir une redevance à verser. Elle peut être exprimée en pourcentage de votre chiffre d'affaires ou en montant fixe annuel.">ℹ️</span>
                        </label>
                        <div class="radio-group" style="margin-bottom: 5px; display: flex; flex-wrap: wrap; gap: 15px;">
                            <label>
                                <input type="radio" name="redevance-type" value="pourcentage" checked>
                                Pourcentage du CA
                            </label>
                            <label>
                                <input type="radio" name="redevance-type" value="fixe">
                                Montant fixe annuel
                            </label>
                        </div>
                        <div id="redevance-pourcentage-container" style="margin-top: 5px;">
                            <input type="number" id="redevance-pourcentage-input" min="0" max="100" step="0.01" placeholder="Ex: 10">
                            <small>% de votre chiffre d'affaires</small>
                        </div>
                        <div id="redevance-fixe-container" style="display: none; margin-top: 5px;">
                            <input type="number" id="redevance-fixe-input" min="0" step="0.01" placeholder="Ex: 5000">
                            <small>€ par an</small>
                        </div>
            </section>

            <!-- SECTION 2: ORGANISATION HEBDOMADAIRE -->
            <section class="form-section section-saisie">
                <h2>2. Organisation hebdomadaire</h2>
                <div class="content-card">
                    <p class="section-intro">Cochez les demi-journées où vous travaillez et indiquez le nombre de séances pour chaque demi-journée.</p>
                    
                    <table class="semaine-table">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Lundi</th>
                                <th>Mardi</th>
                                <th>Mercredi</th>
                                <th>Jeudi</th>
                                <th>Vendredi</th>
                                <th>Samedi</th>
                                <th>Dimanche</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="periode-label"><strong>Matin</strong></td>
                                <td><label class="checkbox-cell"><input type="checkbox" class="travaille-matin" data-jour="lundi"><input type="number" class="seances-demi-journee" data-jour="lundi" data-demi="matin" min="0" step="1" placeholder="0" value="0" disabled></label></td>
                                <td><label class="checkbox-cell"><input type="checkbox" class="travaille-matin" data-jour="mardi"><input type="number" class="seances-demi-journee" data-jour="mardi" data-demi="matin" min="0" step="1" placeholder="0" value="0" disabled></label></td>
                                <td><label class="checkbox-cell"><input type="checkbox" class="travaille-matin" data-jour="mercredi"><input type="number" class="seances-demi-journee" data-jour="mercredi" data-demi="matin" min="0" step="1" placeholder="0" value="0" disabled></label></td>
                                <td><label class="checkbox-cell"><input type="checkbox" class="travaille-matin" data-jour="jeudi"><input type="number" class="seances-demi-journee" data-jour="jeudi" data-demi="matin" min="0" step="1" placeholder="0" value="0" disabled></label></td>
                                <td><label class="checkbox-cell"><input type="checkbox" class="travaille-matin" data-jour="vendredi"><input type="number" class="seances-demi-journee" data-jour="vendredi" data-demi="matin" min="0" step="1" placeholder="0" value="0" disabled></label></td>
                                <td><label class="checkbox-cell"><input type="checkbox" class="travaille-matin" data-jour="samedi"><input type="number" class="seances-demi-journee" data-jour="samedi" data-demi="matin" min="0" step="1" placeholder="0" value="0" disabled></label></td>
                                <td><label class="checkbox-cell"><input type="checkbox" class="travaille-matin" data-jour="dimanche"><input type="number" class="seances-demi-journee" data-jour="dimanche" data-demi="matin" min="0" step="1" placeholder="0" value="0" disabled></label></td>
                            </tr>
                            <tr>
                                <td class="periode-label"><strong>Après-midi</strong></td>
                                <td><label class="checkbox-cell"><input type="checkbox" class="travaille-apres-midi" data-jour="lundi"><input type="number" class="seances-demi-journee" data-jour="lundi" data-demi="apres-midi" min="0" step="1" placeholder="0" value="0" disabled></label></td>
                                <td><label class="checkbox-cell"><input type="checkbox" class="travaille-apres-midi" data-jour="mardi"><input type="number" class="seances-demi-journee" data-jour="mardi" data-demi="apres-midi" min="0" step="1" placeholder="0" value="0" disabled></label></td>
                                <td><label class="checkbox-cell"><input type="checkbox" class="travaille-apres-midi" data-jour="mercredi"><input type="number" class="seances-demi-journee" data-jour="mercredi" data-demi="apres-midi" min="0" step="1" placeholder="0" value="0" disabled></label></td>
                                <td><label class="checkbox-cell"><input type="checkbox" class="travaille-apres-midi" data-jour="jeudi"><input type="number" class="seances-demi-journee" data-jour="jeudi" data-demi="apres-midi" min="0" step="1" placeholder="0" value="0" disabled></label></td>
                                <td><label class="checkbox-cell"><input type="checkbox" class="travaille-apres-midi" data-jour="vendredi"><input type="number" class="seances-demi-journee" data-jour="vendredi" data-demi="apres-midi" min="0" step="1" placeholder="0" value="0" disabled></label></td>
                                <td><label class="checkbox-cell"><input type="checkbox" class="travaille-apres-midi" data-jour="samedi"><input type="number" class="seances-demi-journee" data-jour="samedi" data-demi="apres-midi" min="0" step="1" placeholder="0" value="0" disabled></label></td>
                                <td><label class="checkbox-cell"><input type="checkbox" class="travaille-apres-midi" data-jour="dimanche"><input type="number" class="seances-demi-journee" data-jour="dimanche" data-demi="apres-midi" min="0" step="1" placeholder="0" value="0" disabled></label></td>
                            </tr>
                        </tbody>
                    </table>
                    
                    <div class="key-figures-grid">
                        <div class="key-figure-card">
                            <div class="key-figure-label">Séances par semaine</div>
                            <div class="key-figure-value" id="seances-semaine">0</div>
                        </div>
                        <div class="key-figure-card">
                            <div class="key-figure-label">Jours travaillés par semaine</div>
                            <div class="key-figure-value" id="jours-semaine-calc">0</div>
                        </div>
            </section>

            <!-- SECTION 3: TEMPS DE TRAVAIL RÉEL ANNUEL -->
            <section class="form-section section-saisie">
                <h2>3. Temps de travail réel annuel</h2>
                <div class="content-card">
                <p style="margin-bottom: 20px; color: var(--text-light);">Pour 2026, nous nous basons sur une année de <strong>53 semaines</strong>. Ce nombre de semaines sera utilisé pour tous les calculs.</p>
                <div class="form-group">
                    <label for="semaines-vacances">Nombre de semaines de vacances prévues
                        <span class="tooltip-icon" title="Indiquez le nombre de semaines complètes où vous ne travaillerez pas dans l'année. Ces semaines seront soustraites des 53 semaines de l'année pour calculer vos semaines réellement travaillées.">ℹ️</span>
                    </label>
                    <input type="number" id="semaines-vacances" min="0" max="53" step="1" placeholder="Ex: 5">
                </div>
                <div class="form-group">
                    <label for="jours-feries">Nombre de jours fériés tombant sur des jours travaillés
                        <span class="tooltip-icon" title="Comptez uniquement les jours fériés qui tombent sur un jour où vous travaillez habituellement ET qui ne sont pas déjà inclus dans vos semaines de vacances. Ces jours seront soustraits du nombre total de jours travaillés.">ℹ️</span>
                    </label>
                    <input type="number" id="jours-feries" min="0" max="15" step="1" placeholder="Ex: 8">
                </div>
                <div style="margin-bottom: 20px;">
                    <button type="button" class="btn-secondary" id="btn-calendrier-feries" style="width: 100%;">📅 Voir le calendrier 2026</button>
                </div>
                
                <!-- Résultats intégrés dans la carte -->
                <div class="card-divider"></div>
                <div class="key-figures-grid">
                    <div class="key-figure-card">
                        <div class="key-figure-label">Semaines réellement travaillées</div>
                        <div class="key-figure-value" id="semaines-travaillees">0</div>
                    </div>
                    <div class="key-figure-card">
                        <div class="key-figure-label">Jours travaillés dans l'année</div>
                        <div class="key-figure-value" id="jours-travaillees">0</div>
                    </div>
                    <div class="key-figure-card">
                        <div class="key-figure-label">Séances annuelles</div>
                        <div class="key-figure-value" id="seances-annuelles">0</div>
                    </div>
            </section>

            <!-- SECTION 4: CHIFFRE D'AFFAIRES BRUT -->
            <section class="form-section">
                <h2>4. Chiffre d'affaires BRUT</h2>
                <div class="content-card">
                    <div class="key-figures-grid">
                    <div class="key-figure-card">
                        <div class="key-figure-label">Chiffre d'affaires annuel BRUT</div>
                        <div class="key-figure-value" id="ca-annuel-brut">0 €</div>
                    </div>
                    <div class="key-figure-card">
                        <div class="key-figure-label">Chiffre d'affaires mensuel moyen BRUT</div>
                        <div class="key-figure-value" id="ca-mensuel">0 €</div>
                    </div>
                    <div class="key-figure-card" id="redevance-result" style="display: none;">
                        <div class="key-figure-label">Redevance annuelle (à déduire)</div>
                        <div class="key-figure-value" id="redevance-annuelle">0 €</div>
                    </div>
            </section>

            <!-- SECTION 5: CHARGES MENSUELLES -->
            <section class="form-section section-saisie">
                <h2>5. Charges / Achats (montants mensuels)</h2>
                <div class="content-card">
                
                <!-- Catégorie : Locaux -->
                <div class="charge-category">
                    <div class="charge-category-header" onclick="toggleChargeCategory('locaux')">
                        <h3>🏢 Locaux</h3>
                        <span class="charge-category-icon" id="locaux-icon">▼</span>
                    </div>
                    <div class="charge-category-content" id="locaux-content">
                        <div class="charges-grid">
                            <div class="form-group">
                                <label for="charge-loyer">Loyer</label>
                                <input type="number" class="charge-input" id="charge-loyer" min="0" step="0.01" placeholder="0">
                                <small class="charge-annuel" id="charge-loyer-annuel">0 €/an</small>
                            </div>
                            <div class="form-group">
                                <label for="charge-locatives">Charges locatives</label>
                                <input type="number" class="charge-input" id="charge-locatives" min="0" step="0.01" placeholder="0">
                                <small class="charge-annuel" id="charge-locatives-annuel">0 €/an</small>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Catégorie : Abonnements -->
                <div class="charge-category">
                    <div class="charge-category-header" onclick="toggleChargeCategory('abonnements')">
                        <h3>📱 Abonnements</h3>
                        <span class="charge-category-icon" id="abonnements-icon">▼</span>
                    </div>
                    <div class="charge-category-content" id="abonnements-content">
                        <div class="charges-grid">
                            <div class="form-group">
                                <label for="charge-logiciels">Abonnements logiciels</label>
                                <input type="number" class="charge-input" id="charge-logiciels" min="0" step="0.01" placeholder="0">
                                <small class="charge-annuel" id="charge-logiciels-annuel">0 €/an</small>
                            </div>
                            <div class="form-group">
                                <label for="charge-telephone">Téléphone / Internet</label>
                                <input type="number" class="charge-input" id="charge-telephone" min="0" step="0.01" placeholder="0">
                                <small class="charge-annuel" id="charge-telephone-annuel">0 €/an</small>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Catégorie : Déplacements -->
                <div class="charge-category">
                    <div class="charge-category-header" onclick="toggleChargeCategory('deplacements')">
                        <h3>🚗 Déplacements</h3>
                        <span class="charge-category-icon" id="deplacements-icon">▼</span>
                    </div>
                    <div class="charge-category-content" id="deplacements-content">
                        <div class="charges-grid">
                            <div class="form-group">
                                <label for="charge-deplacement">Frais de déplacement (hors IK)</label>
                                <input type="number" class="charge-input" id="charge-deplacement" min="0" step="0.01" placeholder="0">
                                <small class="charge-annuel" id="charge-deplacement-annuel">0 €/an</small>
                            </div>
                            <div class="form-group">
                                <label for="charge-repas">Frais de repas professionnels</label>
                                <input type="number" class="charge-input" id="charge-repas" min="0" step="0.01" placeholder="0">
                                <small class="charge-annuel" id="charge-repas-annuel">0 €/an</small>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Catégorie : Administratif -->
                <div class="charge-category">
                    <div class="charge-category-header" onclick="toggleChargeCategory('administratif')">
                        <h3>📋 Administratif</h3>
                        <span class="charge-category-icon" id="administratif-icon">▼</span>
                    </div>
                    <div class="charge-category-content" id="administratif-content">
                        <div class="charges-grid">
                            <div class="form-group">
                                <label for="charge-assurances">Assurances</label>
                                <input type="number" class="charge-input" id="charge-assurances" min="0" step="0.01" placeholder="0">
                                <small class="charge-annuel" id="charge-assurances-annuel">0 €/an</small>
                            </div>
                            <div class="form-group">
                                <label for="charge-mutuelle">Mutuelle / Prévoyance</label>
                                <input type="number" class="charge-input" id="charge-mutuelle" min="0" step="0.01" placeholder="0">
                                <small class="charge-annuel" id="charge-mutuelle-annuel">0 €/an</small>
                            </div>
                            <div class="form-group">
                                <label for="charge-honoraires">Honoraires (expert-comptable, avocat...)</label>
                                <input type="number" class="charge-input" id="charge-honoraires" min="0" step="0.01" placeholder="0">
                                <small class="charge-annuel" id="charge-honoraires-annuel">0 €/an</small>
                            </div>
                            <div class="form-group">
                                <label for="charge-bancaires">Frais bancaires</label>
                                <input type="number" class="charge-input" id="charge-bancaires" min="0" step="0.01" placeholder="0">
                                <small class="charge-annuel" id="charge-bancaires-annuel">0 €/an</small>
                            </div>
                            <div class="form-group">
                                <label for="charge-cfe">CFE</label>
                                <input type="number" class="charge-input" id="charge-cfe" min="0" step="0.01" placeholder="0">
                                <small class="charge-annuel" id="charge-cfe-annuel">0 €/an</small>
                            </div>
                            <div class="form-group">
                                <label for="charge-interets">Intérêts d'emprunt</label>
                                <input type="number" class="charge-input" id="charge-interets" min="0" step="0.01" placeholder="0">
                                <small class="charge-annuel" id="charge-interets-annuel">0 €/an</small>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Catégorie : Autres -->
                <div class="charge-category">
                    <div class="charge-category-header" onclick="toggleChargeCategory('autres')">
                        <h3>📦 Autres</h3>
                        <span class="charge-category-icon" id="autres-icon">▼</span>
                    </div>
                    <div class="charge-category-content" id="autres-content">
                        <div class="charges-grid">
                            <div class="form-group">
                                <label for="charge-petit-materiel">Petit matériel et fournitures</label>
                                <input type="number" class="charge-input" id="charge-petit-materiel" min="0" step="0.01" placeholder="0">
                                <small class="charge-annuel" id="charge-petit-materiel-annuel">0 €/an</small>
                            </div>
                            <div class="form-group">
                                <label for="charge-formations">Formations professionnelles</label>
                                <input type="number" class="charge-input" id="charge-formations" min="0" step="0.01" placeholder="0">
                                <small class="charge-annuel" id="charge-formations-annuel">0 €/an</small>
                            </div>
                        </div>
                    </div>
                </div>
                </div>
                
                <div class="key-figures-grid" style="margin-top: var(--space-m);">
                    <div class="key-figure-card key-figure-card-discrete">
                        <div class="key-figure-label">Total des charges (mensuel)</div>
                        <div class="key-figure-value" id="total-charges-mensuel">0 €</div>
                    </div>
                    <div class="key-figure-card key-figure-card-discrete">
                        <div class="key-figure-label">Total des charges (annuel)</div>
                        <div class="key-figure-value" id="total-charges-annuel">0 €</div>
                    </div>
                </div>
            </section>

            <!-- SECTION 6: INDEMNITÉS KILOMÉTRIQUES -->
            <section class="form-section section-saisie">
                <h2>6. Indemnités kilométriques (IK)</h2>
                <div class="content-card">
                    <div class="form-group">
                        <label>
                            <input type="checkbox" id="utilise-vehicule">
                            J'utilise mon véhicule pour le travail
                        </label>
                    </div>
                    <div id="ik-details" style="display: none;">
                        <div class="form-group">
                            <label for="type-vehicule">Type de véhicule
                                <span class="tooltip-icon" title="Le type de véhicule détermine le barème fiscal utilisé pour calculer vos indemnités kilométriques. Les véhicules hybrides et électriques bénéficient de taux majorés.">ℹ️</span>
                            </label>
                            <select id="type-vehicule">
                                <option value="thermique">Thermique</option>
                                <option value="hybride">Hybride</option>
                                <option value="electrique">Électrique</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="puissance-fiscale">Puissance fiscale (CV)
                                <span class="tooltip-icon" title="La puissance fiscale (chevaux fiscaux) se trouve sur votre carte grise. Elle détermine le taux d'indemnité kilométrique selon le barème fiscal officiel.">ℹ️</span>
                            </label>
                            <input type="number" id="puissance-fiscale" min="1" max="20" step="1" placeholder="Ex: 5">
                        </div>
                        <div class="form-group">
                            <label for="km-mois">Kilomètres parcourus par mois
                                <span class="tooltip-icon" title="Estimez le nombre moyen de kilomètres que vous parcourez chaque mois pour votre activité professionnelle (déplacements entre votre cabinet et vos patients, visites à domicile, etc.).">ℹ️</span>
                            </label>
                            <input type="number" id="km-mois" min="0" step="1" placeholder="Ex: 500">
                        </div>
                    </div>
                </div>
                <div class="result-card" id="ik-result" style="display: none;">
                    <div class="result-card-label">🚗 Indemnités kilométriques annuelles</div>
                    <div class="result-card-value" id="ik-annuel">0 €</div>
                </div>
            </section>

            <!-- SECTION 7: AMORTISSEMENTS -->
            <section class="form-section section-saisie">
                <h2>7. Amortissements
                    <span class="tooltip-icon" title="Les amortissements concernent les achats de biens de plus de 500€. Ils permettent de répartir le coût d'un bien sur plusieurs années. Par exemple, un ordinateur acheté 1200€ sur 3 ans donne un amortissement annuel de 400€. C'est une charge déductible fiscalement." style="font-size: 0.6em; vertical-align: middle;">ℹ️</span>
                </h2>
                <div class="content-card">
                    <div id="amortissements-list">
                        <!-- Les biens amortissables seront ajoutés dynamiquement -->
                    </div>
                    <button type="button" class="btn-secondary" id="btn-ajouter-bien" style="margin-top: 20px;">+ Ajouter un bien</button>
                </div>
                <div class="key-figures-grid" style="margin-top: var(--space-m);">
                    <div class="key-figure-card key-figure-card-discrete">
                        <div class="key-figure-label">Total des amortissements annuels</div>
                        <div class="key-figure-value" id="total-amortissements">0 €</div>
            </section>

            <!-- SECTION 9: RÉSULTATS FINAUX -->
            <section class="form-section section-final-result">
                <h2 class="final-result-title">RÉSULTAT FINANCIER</h2>
                
                <div class="content-card">
                    <!-- 1. Carte principale centrée - Résultat avant cotisations -->
                    <div class="result-hero">
                        <div class="result-hero-label">Résultat avant cotisations</div>
                        <div class="result-hero-value" id="result-avant-cotisations">0 €</div>
                        <div class="interpretation-text" id="interpretation-text" style="display: none; margin-top: var(--space-m); text-align: center; font-size: 1em; color: #4a5568; font-style: italic; line-height: 1.6;">
                            Avec ce scénario, ton activité te permet de dégager environ <strong id="interpretation-amount">0 €</strong> nets/mois avant cotisations.
                        </div>
                    </div>
                    
                    <!-- 2. 2 cartes secondaires -->
                    <div class="result-secondary-line">
                        <div class="key-figure-card">
                            <div class="key-figure-label">Chiffre d'affaires annuel</div>
                            <div class="key-figure-value" id="result-ca">0 €</div>
                        </div>
                        <div class="key-figure-card">
                            <div class="key-figure-label">Total des dépenses</div>
                            <div class="key-figure-value" id="result-total-depenses">0 €</div>
                        </div>
                    </div>
                    
                    <!-- 3. Détail des dépenses (liste) -->
                    <div class="expenses-detail">
                        <h3 class="expenses-detail-title">Détail des dépenses annuelles</h3>
                        <table class="expenses-table">
                            <tbody>
                                <tr>
                                    <td class="expense-label">Charges et achats</td>
                                    <td class="expense-amount" id="result-charges">0 €</td>
                                </tr>
                                <tr>
                                    <td class="expense-label">Indemnités kilométriques</td>
                                    <td class="expense-amount" id="result-ik">0 €</td>
                                </tr>
                                <tr>
                                    <td class="expense-label">Amortissements</td>
                                    <td class="expense-amount" id="result-amortissements">0 €</td>
                                </tr>
                                <tr>
                                    <td class="expense-label expense-total-label">Total des dépenses</td>
                                    <td class="expense-amount expense-total-amount" id="result-total-depenses-detail">0 €</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    
                    <!-- Scénarios multiples intégrés -->
                    <div class="scenarios-in-result">
                        <p class="scenarios-intro">Tu peux aussi tester des scénarios prédéfinis qui modifient ton taux de remplissage (le pourcentage de séances que tu arrives à remplir) :</p>
                        <div class="scenarios-buttons">
                            <button type="button" class="btn-scenario-secondary" id="scenario-optimiste">Optimiste : +10 % de taux de remplissage</button>
                            <button type="button" class="btn-scenario-secondary" id="scenario-realiste">Réaliste : taux de remplissage actuel</button>
                            <button type="button" class="btn-scenario-secondary" id="scenario-pessimiste">Pessimiste : -10 % de taux de remplissage</button>
                        </div>
                    </div>
                </div>
                
                <div class="info-box" style="margin-top: var(--space-m);">
                    <p><strong>Note :</strong> Les cotisations sociales ne sont pas incluses dans ce calcul. Consultez votre expert-comptable si vous avez des questions.</p>
                </div>
            </section>

            <!-- SECTION 10: SIMULATIONS "ET SI..." -->
            <section class="form-section simulation-section">
                <h2>Simulations "Et si..."</h2>
                <div class="content-card">
                    <p class="simulation-intro">Explore différents scénarios pour voir l'impact sur tes résultats. Les modifications ci-dessous n'affectent pas ton résultat financier principal.</p>
                    
                    <!-- Lignes structurées : titre à gauche, deux inputs alignés -->
                    <div class="simulation-lines">
                        <div class="simulation-line">
                            <div class="simulation-line-label">Séances par semaine</div>
                            <div class="simulation-line-inputs">
                                <div class="simulation-input-group">
                                    <label class="simulation-input-label">Je fais PLUS</label>
                                    <input type="number" id="simul-consultations-ajout" min="0" step="1" class="simul-input" placeholder="0">
                                    <span class="simulation-input-unit">séances / semaine</span>
                                </div>
                                <div class="simulation-input-group">
                                    <label class="simulation-input-label">Je fais MOINS</label>
                                    <input type="number" id="simul-consultations-reduction" min="0" step="1" class="simul-input" placeholder="0">
                                    <span class="simulation-input-unit">séances / semaine</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="simulation-line">
                            <div class="simulation-line-label">Charges mensuelles</div>
                            <div class="simulation-line-inputs">
                                <div class="simulation-input-group">
                                    <label class="simulation-input-label">+ charges</label>
                                    <input type="number" id="simul-charges-ajout" min="0" step="0.01" class="simul-input" placeholder="0">
                                    <span class="simulation-input-unit">€ / mois</span>
                                </div>
                                <div class="simulation-input-group">
                                    <label class="simulation-input-label">− charges</label>
                                    <input type="number" id="simul-charges-reduction" min="0" step="0.01" class="simul-input" placeholder="0">
                                    <span class="simulation-input-unit">€ / mois</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="simulation-line">
                            <div class="simulation-line-label">Semaines de vacances</div>
                            <div class="simulation-line-inputs">
                                <div class="simulation-input-group">
                                    <label class="simulation-input-label">+ semaines</label>
                                    <input type="number" id="simul-vacances-plus" min="0" max="53" step="1" class="simul-input" placeholder="0">
                                    <span class="simulation-input-unit">semaines</span>
                                </div>
                                <div class="simulation-input-group">
                                    <label class="simulation-input-label">− semaines</label>
                                    <input type="number" id="simul-vacances-moins" min="0" max="53" step="1" class="simul-input" placeholder="0">
                                    <span class="simulation-input-unit">semaines</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Résultats après simulation (même structure que Résultat financier) -->
                <div class="simulation-results-block">
                    <h3 class="simulation-results-title">Résultats après simulation "Et si..."</h3>
                    
                    <div class="content-card">
                        <!-- Carte principale -->
                        <div class="result-hero">
                            <div class="result-hero-label">Résultat avant cotisations</div>
                            <div class="result-hero-value" id="simul-result-avant-cotisations">0 €</div>
                            <div class="simulation-result-diff" id="simul-diff-resultat"></div>
                        </div>
                        
                        <!-- 2 cartes secondaires -->
                        <div class="result-secondary-line">
                            <div class="key-figure-card">
                                <div class="key-figure-label">Chiffre d'affaires annuel</div>
                                <div class="key-figure-value" id="simul-result-ca">0 €</div>
                                <div class="simulation-result-diff" id="simul-diff-ca"></div>
                            </div>
                            <div class="key-figure-card">
                                <div class="key-figure-label">Total des dépenses</div>
                                <div class="key-figure-value" id="simul-result-total-depenses">0 €</div>
                            </div>
                        </div>
            </section>

        <footer>
            <p class="disclaimer-title">Avertissement</p>
            <p class="disclaimer-text">Ce simulateur est un outil d'estimation à titre informatif uniquement. Les montants réels peuvent varier selon votre situation professionnelle, votre régime fiscal et d'autres facteurs spécifiques. Emma-CoachTonCab ne garantit pas l'exactitude des résultats obtenus et ne pourra être tenue responsable d'erreurs, d'omissions ou de décisions prises sur la base des informations fournies par ce simulateur. Il est recommandé de consulter un expert-comptable ou un conseil fiscal pour une analyse précise de votre situation.</p>
            <p class="copyright">© 2026 Emma-CoachTonCab - Tous droits réservés - Reproduction interdite</p>
        </footer>
    </div>

    <!-- Modale pour sauvegarder une simulation -->
    <div id="modal-save" class="modal">
        <div class="modal-content">
            <span class="modal-close">&times;</span>
            <h2>💾 Sauvegarder la simulation</h2>
            <div class="form-group">
                <label for="simulation-name">Nom de la simulation :</label>
                <input type="text" id="simulation-name" placeholder="Ex: Simulation optimiste 2024" maxlength="50">
                <small>Donnez un nom à cette simulation pour la retrouver facilement</small>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn-secondary" id="btn-confirm-save">Sauvegarder</button>
                <button type="button" class="btn-remove" id="btn-cancel-save">Annuler</button>
            </div>
        </div>
    </div>

    <!-- Modale pour afficher les simulations sauvegardées -->
    <div id="modal-load" class="modal">
        <div class="modal-content modal-large">
            <span class="modal-close">&times;</span>
            <h2>📂 Mes simulations sauvegardées</h2>
            <div id="simulations-list" class="simulations-list">
                <p class="no-simulations">Aucune simulation sauvegardée pour le moment.</p>
            </div>
        </div>
    </div>

    <!-- Modale pour le calendrier des jours fériés 2026 -->
    <div id="modal-calendrier-feries" class="modal">
        <div class="modal-content modal-large">
            <span class="modal-close">&times;</span>
            <h2>📅 Calendrier des jours fériés 2026</h2>
            <div id="calendrier-container" style="margin-top: 20px;">
                <!-- Le calendrier sera généré par JavaScript -->
            </div>
        </div>
    </div>

    <script src="script.js"></script>
</body>
</html>
