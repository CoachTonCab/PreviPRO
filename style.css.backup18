}

.mini-card-value {
    font-size: 2.8em;
    font-weight: 700;
    color: #073641;
    line-height: 1.2;
    margin-top: 12px;
}
/* Jours de la semaine (section 2) - mini cartes sans ombre */
.day-checkbox-container {
    background: #ffffff;
