/* Catégories de charges (section 5) */
.charge-category {
    margin-bottom: var(--space-s);
}

.charge-category-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    background: #f8fafc;
    border-radius: 8px;
    cursor: pointer;
    margin-bottom: 20px;
    transition: background 0.2s;
    border: none;
}



.charge-category-header h3 {
    margin: 0;
    color: #073641;
    font-size: 1.1em;
}

.charge-category-icon {
    transition: transform 0.3s;
    font-size: 0.8em;
    color: #fa6d04;
}

.charge-category-icon.rotated {
    transform: rotate(180deg);
}

.charge-category-content {
    display: none;
}

.charge-category-content.active {
    display: block;
}

.charges-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-s);
}

/* Scénarios (section 8) */
.scenarios-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 32px;
}

.scenario-card {
    /* Utilise content-card maintenant */
}

.btn-scenario {
    width: 100%;
    padding: 12px 24px;
    background: #fa6d04;
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 1em;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
}

.btn-scenario:hover {
    background: #e55a00;
}


    
    .charges-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-s);
}
    
    .results-summary {
        grid-template-columns: 1fr;
    }
    
    .result-card.main-result {
        grid-column: 1;
    }
    
    .scenarios-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 32px;
}
    
    .header-actions {
        flex-direction: column;
    }
    
    .btn-export {
        width: 100%;
    }
    
    .main-results-grid {
        grid-template-columns: 1fr;
        gap: 20px;
    }
    
    .result-main-value {
        font-size: 2em !important;
    }
    
    .expense-category,
    .expense-total {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
    }
    
    .expense-value {
        width: 100%;
        text-align: left;
    }
}

/* Animations */
@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.form-section {
    margin-top: var(--space-l);
    margin-bottom: 0;
    background: transparent;
    border: none;
    box-shadow: none;
    padding: 0;
}

.form-section:first-of-type {
    margin-top: 0;
}

/* Styles pour les modales */
.modal {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(0, 0, 0, 0.5);
    animation: fadeIn 0.3s;
}

.modal-content {
    background-color: #ffffff;
    margin: 5% auto;
    padding: 30px;
    border-radius: 12px;
    width: 90%;
    max-width: 500px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
    position: relative;
}

.modal-large {
    max-width: 800px;
}

.modal-close {
    color: #aaa;
    float: right;
    font-size: 28px;
    font-weight: bold;
    cursor: pointer;
    position: absolute;
    right: 20px;
    top: 20px;
    line-height: 1;
}

.modal-close:hover,
.modal-close:focus {
    color: #000;
}

.modal h2 {
    font-family: 'Market Fresh Bold', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    color: #073641;
    margin-bottom: 20px;
    text-transform: uppercase;
    font-size: 1.5em;
}

.modal-actions {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
    margin-top: 20px;
}

/* Liste des simulations */
.simulations-list {
    max-height: 500px;
    overflow-y: auto;
}





.simulation-info {
    flex: 1;
}

.simulation-name {
    font-weight: 600;
    font-size: 1.1em;
    color: #073641;
    margin-bottom: 5px;
}

.simulation-date {
    font-size: 0.85em;
    color: var(--text-light);
}

.simulation-preview {
    font-size: 0.9em;
    color: var(--text-light);
    margin-top: 5px;
}



.btn-load,
.btn-delete {
    padding: 8px 16px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.9em;
    transition: all 0.3s;
    font-family: 'Playfair Display', serif;
}

.btn-load {
    background: var(--primary-color);
    color: white;
}

.btn-load:hover {
    background: var(--primary-dark);
}

.btn-delete {
    background: var(--danger-color);
    color: white;
}

.btn-delete:hover {
    background: #c0392b;
}

.no-simulations {
    text-align: center;
    padding: 40px;
    color: var(--text-light);
    font-style: italic;
}

/* Responsive pour les modales */
@media (max-width: 768px) {
    .modal-content {
        width: 95%;
        margin: 10% auto;
        padding: 20px;
    }
    
    
    
    
    
    .btn-load,
    .btn-delete {
        flex: 1;
    }
}


